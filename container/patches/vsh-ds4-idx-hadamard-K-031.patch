+# --- DS4 indexer QAT (vllm-strix-halo port) -----------------------------------
+# The reference DeepSeek-V4 indexer graph (official inference model.py
+# Compressor(rotate=True) + ds4.c dsv4_indexer_qat_row) rotates the
+# compressed indexer K/Q with a normalized Hadamard matrix and simulates the
+# FP4 QAT grid BEFORE the fp8 quantization, so quantization happens in the
+# trained basis. vLLM omits this (self.rotate was dead code). Gated by
+# DS4_IDX_OFFICIAL; the Q side (fused_indexer_q.py) and K side must be
+# enabled TOGETHER for the dot product to be computed in the rotated basis.
+import os as _ds4_os
+
+_DS4_IDX_OFFICIAL = _ds4_os.environ.get("DS4_IDX_OFFICIAL", "0") == "1"
+_DS4_QAT_DBG = False
+
+_QAT_H_CACHE = {}
+
+
+def _qat_hadamard(D, device):
+    key = (D, str(device))
+    h = _QAT_H_CACHE.get(key)
+    if h is None:
+        m = torch.ones(1, 1, dtype=torch.float32)
+        base = torch.tensor([[1.0, 1.0], [1.0, -1.0]], dtype=torch.float32)
+        n = 1
+        while n < D:
+            m = torch.kron(base, m)
+            n *= 2
+        h = (m * (D ** -0.5)).to(device).contiguous()
+        _QAT_H_CACHE[key] = h
+    return h
+
+
+@triton.jit
+def _apply_hadamard128(x, H_ptr, D: tl.constexpr):
+    r = tl.arange(0, D)
+    Hm = tl.load(H_ptr + r[:, None] * D + r[None, :])  # [D,D] row-major H[j,i]
+    rot = tl.sum(Hm * x[None, :], axis=1)
+    _B: tl.constexpr = 32
+    r2 = tl.reshape(rot, (D // _B, _B))
+    amax = tl.max(tl.abs(r2), axis=1)
+    amax = tl.maximum(amax, 7.0529664e-38)
+    s = tl.exp2(tl.ceil(tl.log2(amax * (1.0 / 6.0))))
+    y = r2 / s[:, None]
+    y = tl.minimum(tl.maximum(y, -6.0), 6.0)
+    a = tl.abs(y)
+    sg = tl.where(y < 0.0, -1.0, 1.0)
+    qv = tl.where(a < 0.25, 0.0, tl.where(a < 0.75, 0.5, tl.where(a < 1.25, 1.0, tl.where(a < 1.75, 1.5, tl.where(a < 2.5, 2.0, tl.where(a < 3.5, 3.0, tl.where(a < 5.0, 4.0, 6.0)))))))
+    return tl.reshape(qv * sg * s[:, None], (D,))
 
 
